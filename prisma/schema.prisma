generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id        String      @id @default(uuid())
  slug      String?     @unique
  name      String      @default("Pizarra")
  createdAt DateTime    @default(now())
  links     BoardLink[] @relation("ParentBoard")
  targets   BoardLink[] @relation("TargetBoard")
}

model BoardLink {
  id            String @id @default(uuid())
  parentBoardId String
  targetBoardId String
  x             Float
  y             Float
  parentBoard   Board  @relation("ParentBoard", fields: [parentBoardId], references: [id], onDelete: Cascade)
  targetBoard   Board  @relation("TargetBoard", fields: [targetBoardId], references: [id], onDelete: Cascade)

  @@index([parentBoardId])
}
