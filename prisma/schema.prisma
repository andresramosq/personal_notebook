generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  x         Float    @default(120)
  y         Float    @default(120)
  createdAt DateTime @default(now())

  parent   Board?  @relation("BoardTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Board[] @relation("BoardTree")
}
